# Copy this file to ".env" and fill ONE provider. Restart `npm run dev` after editing.

# Option A: Web3Forms (free). Get an access key at https://web3forms.com
#   (enter the admin email; submissions are emailed to that address)
VITE_FORM_PROVIDER=web3forms
VITE_WEB3FORMS_KEY=

# Option B: Formspree (free tier). Create a form at https://formspree.io
#   then paste only the ID from https://formspree.io/f/<ID>
# VITE_FORM_PROVIDER=formspree
# VITE_FORMSPREE_ID=
